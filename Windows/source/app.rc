#include <windows.h>
#include "resource.h"
IDI_APP ICON "app.ico"
1 RT_MANIFEST "app.manifest"
IDD_MAIN DIALOGEX 0,0,280,278
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "ihatemeetings 1.4"
FONT 9,"Segoe UI"
BEGIN
 COMBOBOX TYPE,8,8,58,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 COMBOBOX ADAPTER,70,8,164,110,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 PUSHBUTTON "Refresh",REFRESH,238,8,34,15
 COMBOBOX MODE,8,30,226,135,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 PUSHBUTTON "Test",TESTMODE,238,30,34,15
 COMBOBOX BEHAVIOR,8,52,264,65,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 AUTOCHECKBOX "Random timing",RANDOMTIME,8,77,92,12
 LTEXT "Min / fixed (ms)",-1,104,77,76,11
 LTEXT "Max (ms)",-1,198,77,72,11
 LTEXT "OFF",-1,8,98,38,11
 EDITTEXT OFFMS,104,95,72,15,ES_NUMBER | ES_AUTOHSCROLL
 EDITTEXT OFFMAX,198,95,74,15,ES_NUMBER | ES_AUTOHSCROLL
 LTEXT "ON",-1,8,118,38,11
 EDITTEXT ONMS,104,115,72,15,ES_NUMBER | ES_AUTOHSCROLL
 EDITTEXT ONMAX,198,115,74,15,ES_NUMBER | ES_AUTOHSCROLL
 LTEXT "Cycles",-1,8,140,35,11
 EDITTEXT COUNT,46,137,65,15,ES_NUMBER | ES_AUTOHSCROLL
 AUTOCHECKBOX "Until stopped",FOREVER,125,138,110,12
 LTEXT "Limit (sec)",-1,8,160,45,11
 EDITTEXT LIMIT,58,157,53,15,ES_NUMBER | ES_AUTOHSCROLL
 LTEXT "0 = no limit",-1,125,160,90,11
 LTEXT "",RATE,8,179,264,11
 LTEXT "",NOTE,8,192,264,11
 LTEXT "Hotkey",-1,8,212,34,11
 CONTROL "",HOTKEY,"msctls_hotkey32",WS_TABSTOP | WS_BORDER,46,208,171,16
 PUSHBUTTON "Apply",APPLY,223,208,49,16
 DEFPUSHBUTTON "Start (F6)",START,8,231,128,23
 PUSHBUTTON "Stop / restore",STOP,144,231,128,23
 LTEXT "Ready",STATUS,8,258,264,9
 LTEXT "Emergency: Ctrl+Alt+F12",STATS,8,269,264,9
END

1 VERSIONINFO
 FILEVERSION 1,4,0,0
 PRODUCTVERSION 1,4,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
