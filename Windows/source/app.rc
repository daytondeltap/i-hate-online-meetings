 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "ihatemeetings network switch\0"
   VALUE "FileVersion", "1.4.0.0\0"
   VALUE "InternalName", "ihatemeetings\0"
   VALUE "OriginalFilename", "ihatemeetings.exe\0"
   VALUE "ProductName", "ihatemeetings\0"
   VALUE "ProductVersion", "1.4.0\0"
  END
 END
 BLOCK "VarFileInfo"
